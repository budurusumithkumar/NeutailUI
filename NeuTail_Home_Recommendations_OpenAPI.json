{
  "openapi": "3.1.0",
  "info": {
    "title": "Neu.Tail Home Recommendations UI Integration API",
    "version": "1.0.0",
    "description": "Additive authenticated API contract for category-affinity product recommendations on the NeutailUI Home screen."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local demo backend"
    }
  ],
  "paths": {
    "/api/v1/recommendations/home": {
      "get": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Get in-stock products personalized for the authenticated customer",
        "operationId": "getHomeRecommendations",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Personalized homepage recommendations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeRecommendationsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid limit"
          },
          "503": {
            "description": "Profiling or Discovery unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HomeRecommendationProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "price_gbp",
          "recommended_score",
          "reason_codes",
          "available",
          "available_sizes"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_gbp": {
            "type": "number",
            "minimum": 0
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommended_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "available": {
            "type": "boolean",
            "const": true
          },
          "available_sizes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "style": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "HomeRecommendationSection": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title",
          "products"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HomeRecommendationProduct"
            }
          }
        }
      },
      "HomeRecommendationsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_id",
          "trace_id",
          "generated_at",
          "status",
          "strategy",
          "categories_used",
          "sections"
        ],
        "properties": {
          "recommendation_id": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "NO_RESULTS"
            ]
          },
          "strategy": {
            "type": "string",
            "enum": [
              "CATEGORY_AFFINITY",
              "PROFILE_PREFERENCE",
              "PROFILE_PERSONALIZATION"
            ]
          },
          "categories_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HomeRecommendationSection"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error_code",
          "message"
        ],
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  }
}
